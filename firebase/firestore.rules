rules_version = '2';

// Jwenn Mèt security rules.
//
// Shape of the trust model:
//   * a worker profile is public (that is the point of a marketplace);
//   * a job, an invoice and a chat thread are private to their two parties;
//   * identity documents and reports are admin-only;
//   * ratings, verification status and account status are server-owned —
//     clients can never write them, which is what keeps the badges honest.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isActive() {
      return isSignedIn() &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended');
    }

    // Fields a client may never set on itself.
    function noPrivilegeEscalation() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['role', 'status']);
    }

    // ---------------------------------------------------------------- users
    match /users/{uid} {
      // A profile is readable by its owner, by an admin, and — for the name
      // and photo a counterparty needs — by any signed-in user.
      allow read: if isSignedIn();
      allow create: if isSelf(uid) && request.resource.data.role in ['customer', 'worker'];
      allow update: if isAdmin() || (isSelf(uid) && noPrivilegeEscalation());
      allow delete: if isAdmin();

      match /notifications/{notificationId} {
        allow read: if isSelf(uid) || isAdmin();
        // Only the server writes notifications; clients may mark them read.
        allow update: if isSelf(uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------- workers
    match /workers/{uid} {
      // Trades a worker typed themselves are free text on a world-readable
      // document, so the count is capped here. Per-item length is capped in
      // the client (CustomTrade.maxLength); rules cannot iterate a list, so
      // the backstop for the content itself is the report queue, the same one
      // that covers a bio.
      function customTradesOk() {
        return !('customCategories' in request.resource.data) ||
          (request.resource.data.customCategories is list &&
           request.resource.data.customCategories.size() <= 3);
      }

      allow read: if true;
      allow create: if isSelf(uid) && customTradesOk();
      allow update: if isAdmin() || (isSelf(uid) && isActive() &&
        customTradesOk() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['rating', 'reviewCount', 'jobsCompleted', 'verification', 'suspended']));
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------------------- jobs
    match /jobs/{jobId} {
      function isParty() {
        return isSignedIn() && (
          request.auth.uid == resource.data.customerId ||
          request.auth.uid == resource.data.workerId
        );
      }

      allow read: if isParty() || isAdmin();
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.customerId &&
        request.resource.data.status == 'pending';
      // Either party can move the job along; neither can rewrite who it is for.
      allow update: if (isParty() &&
        request.resource.data.customerId == resource.data.customerId &&
        request.resource.data.workerId == resource.data.workerId) || isAdmin();
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------- reviews
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'published' ||
        isSelf(resource.data.customerId) ||
        isSelf(resource.data.workerId) ||
        isAdmin();
      // One review per completed job, written by the customer on that job.
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.customerId &&
        request.resource.data.rating >= 1 && request.resource.data.rating <= 5 &&
        exists(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)) &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.status == 'completed' &&
        get(/databases/$(database)/documents/jobs/$(request.resource.data.jobId)).data.customerId == request.auth.uid;
      // The worker may only add a reply; moderation belongs to admins.
      allow update: if isAdmin() || (isSelf(resource.data.workerId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['workerReply']));
      allow delete: if isAdmin();
    }

    // --------------------------------------------------------- conversations
    match /conversations/{conversationId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participantIds;
      }

      allow read: if isParticipant() || isAdmin();
      allow create: if isActive() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2;
      allow update: if isParticipant() || isAdmin();
      allow delete: if isAdmin();

      match /messages/{messageId} {
        function inThread() {
          return isSignedIn() && request.auth.uid in
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }

        allow read: if inThread() || isAdmin();
        allow create: if inThread() && isActive() &&
          request.resource.data.senderId == request.auth.uid;
        // Messages are immutable except for read receipts.
        allow update: if inThread() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if isAdmin();
      }
    }

    // ------------------------------------------------------------- invoices
    match /invoices/{invoiceId} {
      allow read: if isSelf(resource.data.customerId) ||
        isSelf(resource.data.workerId) || isAdmin();
      // Created by the worker completing the job; settled only by the server,
      // so a client can never mark its own invoice paid.
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.workerId &&
        request.resource.data.status in ['unpaid', 'processing'];
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ------------------------------------------------- trust and moderation
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isActive() &&
        request.auth.uid == request.resource.data.reporterId &&
        request.resource.data.status == 'open';
      allow update, delete: if isAdmin();
    }

    match /verificationRequests/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && request.resource.data.status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Aggregates maintained by Cloud Functions; the console reads, nobody writes.
    match /stats/{document} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
